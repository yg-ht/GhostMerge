[Unit]
Description=GhostMerge web frontend and unattended worker
Documentation=file://{{PROJECT_DIR}}/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{PROJECT_DIR}}
Environment=PYTHONUNBUFFERED=1
ExecStart={{VENV_DIR}}/bin/gunicorn --bind {{HOST}}:{{PORT}} --workers 1 --worker-class gthread --threads 8 --timeout 120 --graceful-timeout 300 web_app:create_app()
Restart=on-failure
RestartSec=5
TimeoutStopSec=330
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths={{PROJECT_DIR}}
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
